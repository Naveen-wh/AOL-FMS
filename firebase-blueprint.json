        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "createdByUserName": { "type": "string", "maxLength": 128, "description": "Creator user name" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Update timestamp" }
      },
      "required": ["id", "companyName", "invoiceNumber", "invoiceAmount", "dueDate"]
    },
    "EmailSentLog": {
      "title": "EmailSentLog",
      "description": "Log record for outgoing system emails including recipient list, delivery status, category, and audit details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Log identifier" },
        "orderId": { "type": "string", "maxLength": 128, "description": "Associated order ID" },
        "companyName": { "type": "string", "maxLength": 256, "description": "Company name" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Client contact name" },
        "to": { "type": "string", "maxLength": 512, "description": "Recipient email address(es)" },
        "cc": { "type": "string", "maxLength": 512, "description": "CC email address(es)" },
        "bcc": { "type": "string", "maxLength": 512, "description": "BCC email address(es)" },
        "subject": { "type": "string", "maxLength": 512, "description": "Email subject" },

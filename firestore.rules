rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // DEVELOPMENT MODE SECURITY RULES
    // =========================================================================
    // NOTE FOR PRODUCTION DEPLOYMENT:
    // These rules allow open read/write access for authenticated users during
    // development and testing. Before launching to production, revert to strict
    // schema-validated and role-restricted rules.
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow read and write access for development (authenticated or open dev environment)
    match /{document=**} {
      allow read, write: if isSignedIn() || true;
    }
  }
}

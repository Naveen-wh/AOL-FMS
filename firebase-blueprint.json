        "senderUserId": { "type": "string", "maxLength": 128, "description": "Sender user ID" },
        "senderUserName": { "type": "string", "maxLength": 128, "description": "Sender display name" },
        "error": { "type": "string", "maxLength": 2000, "description": "Error message if failed" }
      },
      "required": ["id", "to", "subject", "category", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "User" }, "description": "User profiles and RBAC directory" },
    "/leads/{leadId}": { "schema": { "$ref": "SalesLead" }, "description": "Sales leads and opportunities" },
    "/workflows/{workflowId}": { "schema": { "$ref": "ProjectWorkflow" }, "description": "Project pipelines and workflows" },
    "/products/{productId}": { "schema": { "$ref": "Product" }, "description": "Product catalog" },
    "/tasks/{taskId}": { "schema": { "$ref": "SalesTask" }, "description": "Sales action tasks" },
    "/logs/{logId}": { "schema": { "$ref": "ActionLog" }, "description": "Audit trail log records" },
    "/email_sent_logs/{logId}": { "schema": { "$ref": "EmailSentLog" }, "description": "Sent email tracking records" },
    "/tabSettings/{settingId}": { "schema": { "$ref": "TeamTabSettings" }, "description": "Team-level tab permissions" },
    "/clients/{clientId}": { "schema": { "$ref": "Client" }, "description": "Clients directory" },
    "/teams/{teamId}": { "schema": { "$ref": "Team" }, "description": "Teams and departments" },
    "/orders/{orderId}": { "schema": { "$ref": "OrderOffer" }, "description": "Orders and quotations" },
    "/payment_banks/{bankId}": { "schema": { "$ref": "PaymentBank" }, "description": "Corporate bank accounts" },
    "/payment_details/{detailId}": { "schema": { "$ref": "PaymentDetails" }, "description": "Payment reconciliations" },
    "/payment_records/{recordId}": { "schema": { "$ref": "PaymentReceiptRecord" }, "description": "Individual payment receipt records" },
    "/bad_debtors/{id}": { "schema": { "$ref": "BadDebtor" }, "description": "Bad debtors defaulted invoices" },
    "/faqs/{faqId}": { "schema": { "$ref": "FAQItem" }, "description": "Frequently asked questions" },
    "/bug_requests/{bugId}": { "schema": { "$ref": "BugRequest" }, "description": "Bug and feature tickets" },
    "/settings/{docId}": { "schema": "object", "description": "Global application configurations" },
    "/email_daily_counts/{dateId}": { "schema": "object", "description": "Daily email quota usage records" },
    "/product_categories/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Product categories" },
    "/product_groups/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Product groups" },
    "/manufacturers/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Manufacturers" },
    "/freight_terms/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Freight terms" },
    "/transporters/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Transporters" },
    "/warehouses/{id}": { "schema": { "$ref": "MasterItem" }, "description": "Warehouses" },

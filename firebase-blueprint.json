{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and organizational reporting hierarchy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique identifier (user email)" },
        "name": { "type": "string", "maxLength": 128, "description": "Display name of the user" },
        "role": { "type": "string", "maxLength": 64, "enum": ["Admin", "Senior Manager", "Manager", "Team Lead", "Sales User"], "description": "System role" },
        "accessLevel": { "type": "string", "maxLength": 64, "enum": ["Manager", "Contributor", "Editor"], "description": "Access permission level" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "User email address" },
        "teamName": { "type": "string", "maxLength": 128, "description": "Assigned team" },
        "targetQuota": { "type": "number", "description": "Sales target quota" },
        "reportsTo": { "type": "string", "maxLength": 128, "description": "Reporting manager user ID / email" },
        "phone": { "type": "string", "maxLength": 64, "description": "User phone number" },
        "avatarUrl": { "type": "string", "maxLength": 1000, "description": "Avatar image URL" },
        "showOnDashboard": { "type": "boolean", "description": "Whether to display user in dashboard widgets" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Update timestamp" }
      },
      "required": ["id", "name", "role", "accessLevel", "email", "teamName", "targetQuota"]
    },
    "SalesLead": {
      "title": "SalesLead",
      "description": "Sales deal and leads records tracked and checked dynamically against hierarchy trees.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Lead identifier" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Client contact name" },
        "companyName": { "type": "string", "maxLength": 128, "description": "Company name" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Client email" },
        "phone": { "type": "string", "maxLength": 32, "description": "Phone number" },
        "status": { "type": "string", "maxLength": 64, "description": "Lead status" },
        "value": { "type": "number", "description": "Deal value" },
        "quantity": { "type": "number", "description": "Product quantity" },
        "rate": { "type": "number", "description": "Unit rate" },
        "amount": { "type": "number", "description": "Total amount" },
        "assignedToUserId": { "type": "string", "maxLength": 128, "description": "Assigned sales rep user ID" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "projectId": { "type": "string", "maxLength": 128, "description": "Linked project/product ID" },
        "notes": { "type": "string", "maxLength": 2000, "description": "Interaction notes" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation ISO timestamp" }
      },
      "required": ["id", "clientName", "companyName", "email", "phone", "status", "value", "quantity", "rate", "amount", "assignedToUserId", "createdByUserId", "projectId", "notes", "createdAt"]
    },
    "ProjectWorkflow": {
      "title": "ProjectWorkflow",
      "description": "Workflow pipeline hosting deals.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Workflow identifier" },
        "name": { "type": "string", "maxLength": 128, "description": "Workflow pipeline name" },
        "description": { "type": "string", "maxLength": 1000, "description": "Detailed description" },
        "status": { "type": "string", "maxLength": 64, "description": "Status" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Target client name" },
        "leadsCount": { "type": "number", "description": "Associated leads count" }
      },
      "required": ["id", "name", "description", "status", "clientName", "leadsCount"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Product identifier" },
        "name": { "type": "string", "maxLength": 256, "description": "Product name" },
        "category": { "type": "string", "maxLength": 128, "description": "Category name" },
        "group": { "type": "string", "maxLength": 128, "description": "Group name" },
        "manufacturer": { "type": "string", "maxLength": 128, "description": "Manufacturer name" },
        "teamName": { "type": "string", "maxLength": 128, "description": "Assigned team" },
        "hsnCode": { "type": "string", "maxLength": 64, "description": "HSN Code" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "name", "category", "group", "manufacturer", "createdAt"]
    },
    "SalesTask": {
      "title": "SalesTask",
      "description": "Sales task activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Task identifier" },
        "title": { "type": "string", "maxLength": 256, "description": "Task title" },
        "description": { "type": "string", "maxLength": 2000, "description": "Task description" },
        "dueDate": { "type": "string", "maxLength": 64, "description": "Due date" },
        "priority": { "type": "string", "maxLength": 32, "description": "Priority level" },
        "status": { "type": "string", "maxLength": 64, "description": "Task status" },
        "assignedToUserId": { "type": "string", "maxLength": 128, "description": "Assignee user ID" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "projectId": { "type": "string", "maxLength": 128, "description": "Linked project" },
        "leadId": { "type": "string", "maxLength": 128, "description": "Linked lead ID" }
      },
      "required": ["id", "title", "description", "dueDate", "priority", "status", "assignedToUserId", "createdByUserId", "projectId"]
    },
    "ActionLog": {
      "title": "ActionLog",
      "description": "High integrity audit log item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Log identifier" },
        "timestamp": { "type": "string", "maxLength": 64, "description": "Log timestamp" },
        "userId": { "type": "string", "maxLength": 128, "description": "User ID" },
        "userName": { "type": "string", "maxLength": 128, "description": "User display name" },
        "actionType": { "type": "string", "maxLength": 64, "description": "Action type" },
        "targetType": { "type": "string", "maxLength": 64, "description": "Target entity type" },
        "targetId": { "type": "string", "maxLength": 128, "description": "Target entity ID" },
        "targetName": { "type": "string", "maxLength": 256, "description": "Target name" },
        "details": { "type": "string", "maxLength": 2000, "description": "Audit details" }
      },
      "required": ["id", "timestamp", "userId", "userName", "actionType", "targetType", "targetId", "targetName", "details"]
    },
    "TeamTabSettings": {
      "title": "TeamTabSettings",
      "description": "Per team tab permissions and visibility settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Setting ID" },
        "teamName": { "type": "string", "maxLength": 128, "description": "Team name" },
        "visibleTabs": { "type": "string", "description": "Allowed visible tabs list" }
      },
      "required": ["id", "teamName", "visibleTabs"]
    },
    "Client": {
      "title": "Client",
      "description": "Client profile with billing and contact details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Client ID" },
        "fullName": { "type": "string", "maxLength": 128, "description": "Full contact name" },
        "companyName": { "type": "string", "maxLength": 128, "description": "Company name" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Email address" },
        "phone": { "type": "string", "maxLength": 32, "description": "Phone number" },
        "gst": { "type": "string", "maxLength": 32, "description": "GST number" },
        "city": { "type": "string", "maxLength": 128, "description": "City" },
        "pincode": { "type": "string", "maxLength": 16, "description": "Postal code" },
        "address": { "type": "string", "maxLength": 1000, "description": "Address" },
        "teamName": { "type": "string", "maxLength": 128, "description": "Team name" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "fullName", "companyName", "email", "phone", "gst", "city", "pincode", "address", "createdAt"]
    },
    "Team": {
      "title": "Team",
      "description": "Team organizational structure.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Team ID" },
        "name": { "type": "string", "maxLength": 128, "description": "Team name" },
        "description": { "type": "string", "maxLength": 1000, "description": "Team description" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "OrderOffer": {
      "title": "OrderOffer",
      "description": "Sales order and commercial offer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Order ID" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Client name" },
        "companyName": { "type": "string", "maxLength": 128, "description": "Company name" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Client email" },
        "phone": { "type": "string", "maxLength": 32, "description": "Client phone" },
        "status": { "type": "string", "maxLength": 64, "description": "Order status" },
        "totalValue": { "type": "number", "description": "Total value" },
        "payment": { "type": "string", "maxLength": 256, "description": "Payment terms" },
        "paymentBankId": { "type": "string", "maxLength": 128, "description": "Linked bank ID" },
        "delivery": { "type": "string", "maxLength": 256, "description": "Delivery terms" },
        "otherTerms": { "type": "string", "maxLength": 1000, "description": "Other commercial terms" },
        "assignedToUserId": { "type": "string", "maxLength": 128, "description": "Assigned user ID" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "notes": { "type": "string", "maxLength": 2000, "description": "Internal notes" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "clientName", "companyName", "email", "phone", "status", "totalValue", "payment", "delivery", "otherTerms", "assignedToUserId", "createdByUserId", "notes", "createdAt"]
    },
    "PaymentBank": {
      "title": "PaymentBank",
      "description": "Corporate bank account details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Bank account ID" },
        "bankName": { "type": "string", "maxLength": 256, "description": "Bank name" },
        "accountHolderName": { "type": "string", "maxLength": 256, "description": "Account holder name" },
        "accountNumber": { "type": "string", "maxLength": 64, "description": "Account number" },
        "ifscCode": { "type": "string", "maxLength": 32, "description": "IFSC code" },
        "branch": { "type": "string", "maxLength": 256, "description": "Branch name" },
        "address": { "type": "string", "maxLength": 1000, "description": "Branch address" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "bankName", "accountHolderName", "accountNumber", "ifscCode", "branch", "address", "createdAt"]
    },
    "PaymentDetails": {
      "title": "PaymentDetails",
      "description": "Order payment status, received amounts, and reconciliation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Payment detail ID" },
        "orderId": { "type": "string", "maxLength": 128, "description": "Linked order ID" },
        "amountReceived": { "type": "number", "description": "Amount received" },
        "pendingAmount": { "type": "number", "description": "Pending balance" },
        "paymentStatus": { "type": "string", "maxLength": 64, "description": "Payment status" },
        "paymentReceivedDate": { "type": "string", "maxLength": 64, "description": "Payment received date" },
        "utrId": { "type": "string", "maxLength": 128, "description": "UTR transaction ID" },
        "comments": { "type": "string", "maxLength": 2000, "description": "Reconciliation comments" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Updated timestamp" },
        "updatedByUserId": { "type": "string", "maxLength": 128, "description": "Updated by user ID" },
        "updatedByUserName": { "type": "string", "maxLength": 128, "description": "Updated by user name" }
      },
      "required": ["id", "orderId", "amountReceived", "pendingAmount", "paymentStatus"]
    },
    "PaymentReceiptRecord": {
      "title": "PaymentReceiptRecord",
      "description": "Individual payment receipt entry for tracking payment history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Receipt ID" },
        "orderId": { "type": "string", "maxLength": 128, "description": "Linked order ID" },
        "amount": { "type": "number", "description": "Payment amount received" },
        "paymentReceivedDate": { "type": "string", "maxLength": 64, "description": "Date payment was received" },
        "utrId": { "type": "string", "maxLength": 128, "description": "UTR or transaction reference ID" },
        "comments": { "type": "string", "maxLength": 2000, "description": "Comments or notes" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Record creation timestamp" },
        "createdBy": { "type": "string", "maxLength": 128, "description": "User who recorded the payment" }
      },
      "required": ["id", "orderId", "amount", "paymentReceivedDate", "createdAt"]
    },
    "FAQItem": {
      "title": "FAQItem",
      "description": "Help center and navigation FAQ item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "FAQ ID" },
        "question": { "type": "string", "maxLength": 1000, "description": "Question text" },
        "answer": { "type": "string", "maxLength": 10000, "description": "Detailed answer" },
        "category": { "type": "string", "maxLength": 128, "description": "Category / tab" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Creator user ID" },
        "createdByUserName": { "type": "string", "maxLength": 128, "description": "Creator user name" }
      },
      "required": ["id", "question", "answer", "createdAt"]
    },
    "BugRequest": {
      "title": "BugRequest",
      "description": "Issue or feature request ticket.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Ticket ID" },
        "title": { "type": "string", "maxLength": 256, "description": "Ticket title" },
        "description": { "type": "string", "maxLength": 10000, "description": "Detailed problem description" },
        "type": { "type": "string", "maxLength": 64, "enum": ["Bug", "Feature Request", "Improvement", "Question", "Other"], "description": "Ticket type" },
        "priority": { "type": "string", "maxLength": 32, "enum": ["Low", "Medium", "High", "Critical"], "description": "Priority" },
        "status": { "type": "string", "maxLength": 32, "enum": ["Open", "In Progress", "Resolved", "Closed"], "description": "Status" },
        "isCompleted": { "type": "boolean", "description": "Completion flag" },
        "screenshotUrl": { "type": "string", "maxLength": 1000, "description": "Screenshot attachment URL" },
        "screenshotName": { "type": "string", "maxLength": 256, "description": "Attachment filename" },
        "createdByUserId": { "type": "string", "maxLength": 128, "description": "Author user ID" },
        "createdByUserName": { "type": "string", "maxLength": 128, "description": "Author user name" },
        "createdByEmail": { "type": "string", "maxLength": 128, "description": "Author email" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Update timestamp" },
        "resolvedAt": { "type": "string", "maxLength": 64, "description": "Resolved timestamp" },
        "resolvedByUserName": { "type": "string", "maxLength": 128, "description": "Resolver user name" },
        "adminNotes": { "type": "string", "maxLength": 5000, "description": "Admin response notes" }
      },
      "required": ["id", "title", "description", "type", "priority", "status", "isCompleted", "createdByUserId", "createdByUserName", "createdAt"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Rich text email notification template.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Template ID" },
        "name": { "type": "string", "maxLength": 128, "description": "Template name" },
        "subject": { "type": "string", "maxLength": 256, "description": "Email subject" },
        "body": { "type": "string", "maxLength": 10000, "description": "Email body content" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" },
        "isDefault": { "type": "boolean", "description": "Default template flag" },
        "to": { "type": "string", "maxLength": 256, "description": "Recipient field" },
        "cc": { "type": "string", "maxLength": 256, "description": "Carbon copy field" },
        "bcc": { "type": "string", "maxLength": 256, "description": "Blind carbon copy field" },
        "assignedForm": { "type": "string", "maxLength": 64, "description": "Assigned form event" }
      },
      "required": ["id", "name", "subject", "body", "createdAt"]
    },
    "MasterItem": {
      "title": "MasterItem",
      "description": "Generic master data record for dropdowns and taxonomies.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Item ID" },
        "name": { "type": "string", "maxLength": 256, "description": "Name / value" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation timestamp" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "BadDebtor": {
      "title": "BadDebtor",
      "description": "Bad debtor invoice default record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Record ID" },
        "companyName": { "type": "string", "maxLength": 256, "description": "Defaulted company name" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Client contact person" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Client email" },
        "phone": { "type": "string", "maxLength": 32, "description": "Client phone" },
        "customerPo": { "type": "string", "maxLength": 128, "description": "Customer PO number" },
        "invoiceNumber": { "type": "string", "maxLength": 128, "description": "Invoice number" },
        "invoiceDate": { "type": "string", "maxLength": 64, "description": "Invoice date" },
        "invoiceAmount": { "type": "number", "description": "Invoice amount" },
        "dueDate": { "type": "string", "maxLength": 64, "description": "Payment due date" },
        "overdueDays": { "type": "number", "description": "Overdue days" },
        "comments": { "type": "string", "maxLength": 2000, "description": "Internal comments or remarks" },
